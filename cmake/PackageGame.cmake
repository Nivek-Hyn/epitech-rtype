set(CPACK_PACKAGE_NAME RType)
set(CPACK_PACKAGE_VENDOR "R-Type project team")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Networked multiplayer R-Type")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_VERBATIM_VARIABLES ON)

if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TGZ)
endif()

if(RTYPE_BUILD_CLIENT)
    set(packagePrograms client-server)
else()
    set(packagePrograms server-only)
endif()
set(CPACK_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}-${packagePrograms}")
if(CMAKE_BUILD_TYPE)
    set(CPACK_BUILD_CONFIG "${CMAKE_BUILD_TYPE}")
else()
    set(CPACK_BUILD_CONFIG Release)
endif()

# Package only our runtime component, even when dependencies define their own install rules.
set(CPACK_INSTALL_CMAKE_PROJECTS "${PROJECT_BINARY_DIR};${PROJECT_NAME};GameRuntime;/")
set(CPACK_COMPONENTS_ALL GameRuntime)
set(CPACK_MONOLITHIC_INSTALL OFF)
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/PackageOptions.cmake")
include(CPack)
